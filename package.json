{
  "name": "@codeqr/mcp-remote",
  "version": "0.1.0",
  "description": "Remote MCP server for CodeQR with OAuth 2.0 — compatible with ChatGPT, OpenAI Agents, and any MCP client",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.vercel.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "verify": "yarn typecheck && yarn test && yarn build"
  },
  "dependencies": {
    "@codeqr/ts": "0.24.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@upstash/redis": "^1.35.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jose": "^6.2.8",
    "nanoid": "^6.0.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^26.1.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.8",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "CodeQR <support@codeqr.io>",
  "license": "MIT"
}
