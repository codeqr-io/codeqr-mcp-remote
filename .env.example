# Required: Public URL where this server is accessible
SERVER_URL=https://mcp.codeqr.io

# Port to listen on (default: 3000)
PORT=3000

# Optional: Stainless API key for code execution sandbox
STAINLESS_API_KEY=

# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# Upstash Redis (recommended for Vercel / serverless — persistent OAuth state)
# Create a database at https://upstash.com and copy REST URL + token from the console.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── CodeQR OAuth app ─────────────────────────────────────────────────────────
# This server authorizes users against CodeQR instead of asking them for an API
# key, so it needs its own OAuth app. Create one at
#   <dashboard>/settings/oauth-apps/new
# with PKCE disabled (this is a confidential client) and this redirect URI:
#   <SERVER_URL>/oauth/callback
#
# Without these two values /oauth/authorize answers server_error — on Vercel the
# variables are bound at deploy time, so setting them requires a redeploy to
# take effect.
CODEQR_OAUTH_CLIENT_ID=
CODEQR_OAUTH_CLIENT_SECRET=

# Dashboard origin the user is sent to. Point at the staging dashboard to test
# the flow end to end without touching production accounts.
CODEQR_APP_URL=https://app.codeqr.io
